{
  "$description": "Gran Trakt design tokens (city quiet luxury). Источник правды: tokens.json, tokens.css собран из него.",
  "color": {
    "graphite": {
      "value": "#1E1D1B",
      "role": "Текст на светлом, темные плоскости"
    },
    "basalt": {
      "value": "#2B2A27",
      "role": "Поверхность на темном"
    },
    "patina": {
      "value": "#25382F",
      "role": "Основной фирменный цвет, кнопки, шапка"
    },
    "patina-soft": {
      "value": "#3A5247",
      "role": "Наведение на основной, вторичные плоскости"
    },
    "bone": {
      "value": "#F5F1EA",
      "role": "Основной фон"
    },
    "limestone": {
      "value": "#E8E2D6",
      "role": "Карточки, вторичный фон"
    },
    "sand": {
      "value": "#CFC6B6",
      "role": "Линии, рамки"
    },
    "stone": {
      "value": "#6B6458",
      "role": "Вторичный текст"
    },
    "bronze": {
      "value": "#80582D",
      "role": "Акцент на светлом (ссылки, цифры, бейдж Ultra)"
    },
    "bronze-light": {
      "value": "#C9A878",
      "role": "Акцент на темном"
    },
    "alert": {
      "value": "#9C3A2A",
      "role": "Ошибка"
    },
    "ok": {
      "value": "#3C6A4B",
      "role": "Успех, в наличии"
    }
  },
  "font": {
    "family": {
      "display": "'Cormorant Garamond', 'Times New Roman', serif",
      "text": "'Golos Text', 'Helvetica Neue', Arial, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "size": {
    "display": {
      "size": "clamp(2.75rem, 6vw, 5rem)",
      "lineHeight": "1.02"
    },
    "h1": {
      "size": "clamp(2.25rem, 4.5vw, 3.5rem)",
      "lineHeight": "1.08"
    },
    "h2": {
      "size": "clamp(1.75rem, 3vw, 2.5rem)",
      "lineHeight": "1.12"
    },
    "h3": {
      "size": "1.5rem",
      "lineHeight": "1.2"
    },
    "lead": {
      "size": "1.25rem",
      "lineHeight": "1.55"
    },
    "body": {
      "size": "1.0625rem",
      "lineHeight": "1.65"
    },
    "small": {
      "size": "0.875rem",
      "lineHeight": "1.5"
    },
    "label": {
      "size": "0.75rem",
      "lineHeight": "1.3"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "144px"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "6px",
    "lg": "12px",
    "pill": "999px"
  },
  "shadow": {
    "soft": "0 1px 2px rgba(30,29,27,.06), 0 8px 24px rgba(30,29,27,.06)",
    "lift": "0 2px 4px rgba(30,29,27,.08), 0 18px 40px rgba(30,29,27,.12)"
  },
  "motion": {
    "fast": "140ms",
    "base": "240ms",
    "slow": "480ms",
    "ease": "cubic-bezier(.2,.6,.2,1)"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1100px",
    "xl": "1440px"
  },
  "tier": {
    "lite": {
      "bg": "#E8E2D6",
      "fg": "#1E1D1B",
      "line": "#CFC6B6"
    },
    "pro": {
      "bg": "#25382F",
      "fg": "#F5F1EA",
      "line": "#3A5247"
    },
    "ultra": {
      "bg": "#1E1D1B",
      "fg": "#C9A878",
      "line": "#80582D"
    }
  },
  "rule": {
    "minTouchTarget": "44px",
    "focusRing": "2px solid #25382F, offset 3px (на темном #C9A878)",
    "maxLineLength": "68ch"
  }
}