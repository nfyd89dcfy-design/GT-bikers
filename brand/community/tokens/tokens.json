      "pine": "#1F6B58",
      "mist": "#E4EFE9",
      "white": "#FFFFFF"
    },
    "mode": {
      "youth": {
        "bg": "#F6F1E7",
        "surface": "#FFFFFF",
        "surfaceAlt": "#EDE6D6",
        "text": "#1B1530",
        "textMuted": "#625C78",
        "border": "#D9D2C3",
        "accent": "#C8F03C",
        "onAccent": "#1B1530",
        "action": "#C73A12",
        "onAction": "#FFFFFF",
        "focus": "#5B35E0"
      },
      "parent": {
        "bg": "#E4EFE9",
        "surface": "#FFFFFF",
        "surfaceAlt": "#D3E5DC",
        "text": "#1B1530",
        "textMuted": "#4D4862",
        "border": "#B9D0C5",
        "accent": "#1F6B58",
        "onAccent": "#FFFFFF",
        "action": "#1F6B58",
        "onAction": "#FFFFFF",
        "focus": "#5B35E0"
      }
    },
    "tier": {
      "lite": {
        "bg": "#C8F03C",
        "text": "#1B1530"
      },
      "pro": {
        "bg": "#FF5B2E",
        "text": "#1B1530"
      },
      "ultra": {
        "bg": "#5B35E0",
        "text": "#FFFFFF"
      }
    }
  },
  "font": {
    "display": "Unbounded",
    "body": "Onest",
    "mono": "JetBrains Mono",
    "source": "Google Fonts, кириллица поддерживается"
  },
  "fontSize": {
    "display": "clamp(2.5rem,1.6rem + 4.2vw,5rem)",
    "h1": "clamp(2rem,1.5rem + 2.4vw,3.5rem)",
    "h2": "clamp(1.5rem,1.2rem + 1.4vw,2.25rem)",
    "h3": "1.25rem",
    "body": "1rem",
    "small": "0.875rem",
    "caption": "0.75rem"
  },
  "lineHeight": {
    "tight": 1.05,
    "heading": 1.15,
    "body": 1.55
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "radius": {
    "s": "8px",
    "m": "16px",
    "l": "28px",
    "pill": "999px"
  },
  "shadow": {
    "sticker": "4px 4px 0 #1B1530",
    "soft": "0 8px 24px rgba(27,21,48,0.12)"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "fast": "120ms",
    "base": "220ms",
    "slow": "420ms"
  },
  "breakpoint": {
    "sm": "600px",
    "md": "900px",
    "lg": "1200px"
  }
